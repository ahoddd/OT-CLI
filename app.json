{
  "expo": {
    "name": "OrbTap",
    "slug": "orbtap",
    "version": "1.0.0",
    "scheme": "orbtap",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox",
          "RNMapboxMapsDownloadToken": "sk.public.test"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
