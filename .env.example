# OrbTap — copy to .env and fill in. Do not commit .env.

# Firebase — required. Get from Firebase Console → Project settings → General → Your apps.
# Regenerate the API key in Google Cloud Console if it was ever committed to git.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id

# Mapbox: required for the map tab to show Mapbox (otherwise you see the fallback map).
# Get a public token at https://account.mapbox.com/access-tokens/ (starts with pk.)
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Optional: only needed if Mapbox native SDK requires a download token for Android/iOS builds.
EXPO_PUBLIC_MAPBOX_DOWNLOAD_TOKEN=your_mapbox_download_token_here

# Optional: App and legal URLs (use these in App Store Connect and Google Play Console)
EXPO_PUBLIC_APP_LINK=https://orbtap.com
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://orbtap.com/legal/privacy
EXPO_PUBLIC_TERMS_URL=https://orbtap.com/legal/terms
EXPO_PUBLIC_LEGAL_ADDRESS=Your business address, City, State ZIP
# Store download URLs (for web landing and JSON-LD)
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/orbtap
EXPO_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.orbtap.app
